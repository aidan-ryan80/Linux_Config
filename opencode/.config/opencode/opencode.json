{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "instructions": ["AGENTS.md"],
  "permission": {
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "tree *": "allow",
      "which *": "allow",
      "grep *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "diff *": "allow",
      "file *": "allow",
      "stat *": "allow",
      "du *": "allow",
      "pwd": "allow",
      "echo *": "ask",
      "date": "allow",
      "find *": "allow",
      "locate *": "allow",
      "id": "allow",
      "systemctl status *": "allow",
      "systemctl is-active *": "allow",
      "systemctl list-units *": "allow"
    },
    "task": "allow",
    "todowrite": "allow",
    "skill": "allow",
    "websearch": "ask",
    "external_directory": {
      "*": "ask",
      "/home/aidan/.agents/**": "allow",
      "/home/aidan/Obsidian/**": "allow",
      "/tmp/opencode/**": "allow"
    },
    "edit": {
      "*": "ask",
      "*.agents/**": "allow",
      "*tmp/opencode/**": "allow"
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen2.5-coder:7b-ctx20k": {
          "name": "Qwen 2.5 Coder 7B",
          "limit": {
            "context": 20480,
            "output": 8192
          }
        },
        "qwen2.5:7b-ctx20k": {
          "name": "Qwen 2.5 7B (general)",
          "limit": {
            "context": 20480,
            "output": 8192
          }
        },
        "qwen3:8b-ctx16k": {
          "name": "Qwen3 8B (general)",
          "limit": {
            "context": 16384,
            "output": 8192
          }
        }
      }
    }
  }
}
